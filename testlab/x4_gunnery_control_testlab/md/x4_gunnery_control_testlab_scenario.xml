<!-- Developer-only Test Lab scenario spawner.

  Lua streams one flat transaction because nested Lua tables are not a proven
  UI-to-MD transport:
    scenario_begin  {specId, force, requestId, sectorMacro, anchorX/Y/Z}
    scenario_group  {label, macro, faction, count, distance, spread, x/y,
                     behaviour, hostile, holdFire, stripDefenceUnits, repairGuard,
                     yaw/pitch/roll, preserveOrientation, role, loadout,
                     expectedWeapons, expectedTurrets, expectedMissileTurrets}
    scenario_commit

  A non-empty loadout is the exact id registered in libraries/loadouts.xml.
  MD resolves it with get_loadout and applies it with apply_loadout. Those actions
  are shipped-source in X4 9.00 (common.xsd/showcases.xml); Test Lab then requires
  the authored exact operational totals before READY. A bad or unresolved route
  cannot arm the fixture: it either records a loadout failure or produces no
  correlated READY and Lua times out.
-->
<mdscript name="X4GunneryTestLabScenario" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../#modding/xsd/md.xsd">
  <cues>
    <cue name="ScenarioRoot">
      <cues>

        <!-- ScenarioBegin
             AddUITriggeredEvent("X4GunneryTestLabScenario", "scenario_begin",
               {specId = "...", force = true|false, requestId = "..."})
             Opens an accepting window and clears any half-built queue. -->
        <cue name="ScenarioBegin" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabScenario'" control="'scenario_begin'"/>
          </conditions>
          <actions>
            <set_value name="$SpecId" exact="if @event.param3.$specId then event.param3.$specId else 'unnamed'"/>
            <set_value name="$Force" exact="@event.param3.$force == true"/>
            <set_value name="$RequestId" exact="if @event.param3.$requestId then event.param3.$requestId else ''"/>

            <do_if value="(not $Force) and ScenarioRoot.$SpawnedSpecId? and ScenarioRoot.$SpawnedSpecId == $SpecId">
              <set_value name="ScenarioRoot.$Accepting" exact="false"/>
              <debug_text text="'[X4GC TEST SCENARIO] skipped; spec already spawned id=' + $SpecId"/>
            </do_if>
            <do_else>
              <set_value name="ScenarioRoot.$Accepting" exact="true"/>
              <set_value name="ScenarioRoot.$PendingSpecId" exact="$SpecId"/>
              <set_value name="ScenarioRoot.$PendingRequestId" exact="$RequestId"/>
              <set_value name="ScenarioRoot.$PendingSectorMacro" exact="if @event.param3.$sectorMacro then event.param3.$sectorMacro else ''"/>
              <set_value name="ScenarioRoot.$PendingAnchorX" exact="if @event.param3.$anchorX then event.param3.$anchorX else 0"/>
              <set_value name="ScenarioRoot.$PendingAnchorY" exact="if @event.param3.$anchorY then event.param3.$anchorY else 0"/>
              <set_value name="ScenarioRoot.$PendingAnchorZ" exact="if @event.param3.$anchorZ then event.param3.$anchorZ else 0"/>
              <set_value name="ScenarioRoot.$Pending" exact="[]"/>
              <debug_text text="'[X4GC TEST SCENARIO] accepting spec id=' + $SpecId + ' force=' + $Force"/>
            </do_else>
          </actions>
        </cue>


        <!-- ScenarioGroup: one flat ship-batch record. -->
        <cue name="ScenarioGroup" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabScenario'" control="'scenario_group'"/>
            <check_value value="ScenarioRoot.$Accepting? and ScenarioRoot.$Accepting"/>
          </conditions>
          <actions>
            <append_to_list name="ScenarioRoot.$Pending" exact="table[
              $label     = if @event.param3.$label     then event.param3.$label     else 'target',
              $macro     = if @event.param3.$macro     then event.param3.$macro     else '',
              $faction   = if @event.param3.$faction   then event.param3.$faction   else 'xenon',
              $count     = if @event.param3.$count     then event.param3.$count     else 1,
              $distance  = if @event.param3.$distance  then event.param3.$distance  else 1000,
              $spread    = if @event.param3.$spread    then event.param3.$spread    else 0,
              $x         = if @event.param3.$x         then event.param3.$x         else 0,
              $y         = if @event.param3.$y         then event.param3.$y         else 0,
              $behaviour = if @event.param3.$behaviour then event.param3.$behaviour else 'wait',
              $hostile   = @event.param3.$hostile == true,
              $holdfire  = @event.param3.$holdFire == true,
              $stripdefenceunits = @event.param3.$stripDefenceUnits == true,
              $repairguard = @event.param3.$repairGuard == true,
              $yaw       = if @event.param3.$yaw       then event.param3.$yaw       else 0,
              $pitch     = if @event.param3.$pitch     then event.param3.$pitch     else 0,
              $roll      = if @event.param3.$roll      then event.param3.$roll      else 0,
              $preserveorientation = @event.param3.$preserveOrientation == true,
              $role      = if @event.param3.$role      then event.param3.$role      else '',
              $loadout   = if @event.param3.$loadout   then event.param3.$loadout   else '',
              $expectedweapons = event.param3.$expectedWeapons,
              $expectedturrets = event.param3.$expectedTurrets,
              $expectedmissileturrets = event.param3.$expectedMissileTurrets
            ]"/>
          </actions>
        </cue>

        <!-- ScenarioCommit
             AddUITriggeredEvent("X4GunneryTestLabScenario", "scenario_commit")
             Despawns the previous fixture, then creates every queued group. -->
        <cue name="ScenarioCommit" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabScenario'" control="'scenario_commit'"/>
            <check_value value="ScenarioRoot.$Accepting? and ScenarioRoot.$Accepting"/>
            <check_value value="not (ScenarioRoot.$Spawned? and ScenarioRoot.$Spawned.indexof.{player.ship})"/>
          </conditions>
          <actions>
            <set_value name="ScenarioRoot.$Accepting" exact="false"/>

            <!-- Replace, never stack. -->
            <signal_cue_instantly cue="DespawnScenarioImpl"/>

            <create_group groupname="ScenarioRoot.$Spawned"/>
            <create_group groupname="ScenarioRoot.$SafeObjects"/>
            <create_group groupname="ScenarioRoot.$RepairObjects"/>
            <create_group groupname="ScenarioRoot.$PlayerShooters"/>
            <set_value name="$SafeObjectCount" exact="0"/>
            <set_value name="$SafeWeapons" exact="0"/>
            <set_value name="$UnsafeWeapons" exact="0"/>
            <set_value name="$DefenceUnits" exact="0"/>
            <set_value name="$Hostiles" exact="0"/>
            <set_value name="$RepairObjectCount" exact="0"/>
            <set_value name="$ShooterCount" exact="0"/>
            <set_value name="$ShooterWeapons" exact="0"/>
            <set_value name="$ShooterTurrets" exact="0"/>
            <set_value name="$ShooterMissileTurrets" exact="0"/>
            <set_value name="$LoadoutFailures" exact="0"/>
            <set_value name="$LocationFailures" exact="0"/>
            <set_value name="$DormantShooterWeapons" exact="0"/>
            <set_value name="$UnsafeDormantShooterWeapons" exact="0"/>

            <!-- Argon Prime's shipped macro is Cluster_14_Sector001_macro.
                 Absolute sector positions keep this fixture independent of the
                 save's current sector and exactly 500 km from the origin. -->
            <set_value name="$Remote" exact="ScenarioRoot.$PendingSectorMacro != ''"/>
            <!-- A local fixture is fired on by the ship at whose console Test
                 Lab was opened.  Remote fixtures add their spawned role=shooter
                 ship below.  One group therefore drives repair attribution in
                 both setup modes. -->
            <do_if value="not $Remote">
              <add_to_group groupname="ScenarioRoot.$PlayerShooters" object="player.ship"/>
            </do_if>
            <do_if value="$Remote">
              <set_value name="$SectorMacroName" exact="ScenarioRoot.$PendingSectorMacro"/>
              <do_if value="not @macro.{$SectorMacroName}">
                <set_value name="$LocationFailures" operation="add"/>
                <debug_text text="'[X4GC TEST SCENARIO] unknown remote sector macro=' + $SectorMacroName"/>
              </do_if>
              <do_else>
                <find_sector name="$ScenarioSector" macro="macro.{$SectorMacroName}" checkoperational="false"/>
                <do_if value="not $ScenarioSector">
                  <set_value name="$LocationFailures" operation="add"/>
                  <debug_text text="'[X4GC TEST SCENARIO] remote sector not found macro=' + $SectorMacroName"/>
                </do_if>
              </do_else>
            </do_if>

            <do_for_each name="$Def" in="ScenarioRoot.$Pending">
              <do_if value="$Def.$macro == '' or not @macro.{$Def.$macro}">
                <debug_text text="'[X4GC TEST SCENARIO] skipping group ' + $Def.$label + '; unknown macro=' + $Def.$macro"/>
                <continue/>
              </do_if>

              <set_value name="$Owner" exact="@faction.{$Def.$faction}"/>
              <do_if value="not $Owner">
                <debug_text text="'[X4GC TEST SCENARIO] unknown faction=' + $Def.$faction + ' for group ' + $Def.$label + '; using xenon'"/>
                <set_value name="$Owner" exact="faction.xenon"/>
              </do_if>

              <!-- Clamp to something a live test can actually manage. -->
              <set_value name="$Count" exact="$Def.$count"/>
              <do_if value="$Count lt 1"><set_value name="$Count" exact="1"/></do_if>
              <do_if value="$Count gt 12"><set_value name="$Count" exact="12"/></do_if>

              <set_value name="$Index" exact="0"/>
              <do_all exact="$Count">
                <set_value name="$Index" operation="add"/>

                <do_if value="$Remote">
                  <do_if value="not $ScenarioSector"><continue/></do_if>
                  <do_if value="$Def.$role == 'shooter'">
                    <create_ship name="$Ship" groupname="ScenarioRoot.$Spawned"
                                 sector="$ScenarioSector" macro="macro.{$Def.$macro}">
                      <owner exact="$Owner"/>
                      <loadout><level exact="1.0"/></loadout>
                      <pilot><select faction="$Owner" tags="tag.pilot"/></pilot>
                      <position x="ScenarioRoot.$PendingAnchorX + $Def.$x"
                                y="ScenarioRoot.$PendingAnchorY + $Def.$y"
                                z="ScenarioRoot.$PendingAnchorZ + $Def.$distance"/>
                      <rotation yaw="($Def.$yaw)deg" pitch="($Def.$pitch)deg" roll="($Def.$roll)deg"/>
                    </create_ship>
                  </do_if>
                  <do_else>
                    <create_ship name="$Ship" groupname="ScenarioRoot.$Spawned"
                                 sector="$ScenarioSector" macro="macro.{$Def.$macro}">
                      <owner exact="$Owner"/>
                      <loadout><level exact="1.0"/></loadout>
                      <position x="ScenarioRoot.$PendingAnchorX + $Def.$x"
                                y="ScenarioRoot.$PendingAnchorY + $Def.$y"
                                z="ScenarioRoot.$PendingAnchorZ + $Def.$distance"/>
                      <rotation yaw="($Def.$yaw)deg" pitch="($Def.$pitch)deg" roll="($Def.$roll)deg"/>
                    </create_ship>
                  </do_else>
                </do_if>
                <do_else>
                  <create_ship name="$Ship" groupname="ScenarioRoot.$Spawned"
                               zone="player.zone" macro="macro.{$Def.$macro}">
                    <owner exact="$Owner"/>
                    <loadout><level exact="1.0"/></loadout>
                    <safepos object="player.ship" x="$Def.$x" y="$Def.$y" z="$Def.$distance" max="$Def.$spread"/>
                    <rotation yaw="($Def.$yaw)deg" pitch="($Def.$pitch)deg" roll="($Def.$roll)deg"/>
                  </create_ship>
                </do_else>

                <do_if value="$Def.$loadout != ''">
                  <set_value name="$RequestedLoadout" exact="null"/>
                  <debug_text text="'[X4GC TEST SCENARIO] loadout_lookup stage=start id=' + $Def.$loadout + ' macro=' + $Def.$macro"/>
                  <get_loadout result="$RequestedLoadout" loadout="$Def.$loadout" macro="macro.{$Def.$macro}"/>
                  <do_if value="$RequestedLoadout? and $RequestedLoadout != null">
                    <apply_loadout object="$Ship" loadout="$RequestedLoadout"/>
                    <do_if value="$Ship.weapons.operational.count != $Def.$expectedweapons
                                  or $Ship.turrets.operational.count != $Def.$expectedturrets
                                  or $Ship.missileturrets.operational.count != $Def.$expectedmissileturrets">
                      <set_value name="$LoadoutFailures" operation="add"/>
                      <debug_text text="'[X4GC TEST SCENARIO] loadout_census FAILED id=' + $Def.$loadout + ' ship=' + $Ship + ' weapons=' + $Ship.weapons.operational.count + '/' + $Def.$expectedweapons + ' turrets=' + $Ship.turrets.operational.count + '/' + $Def.$expectedturrets + ' missile_turrets=' + $Ship.missileturrets.operational.count + '/' + $Def.$expectedmissileturrets"/>
                    </do_if>
                    <do_else>
                      <debug_text text="'[X4GC TEST SCENARIO] loadout_census id=' + $Def.$loadout + ' ship=' + $Ship + ' weapons=' + $Ship.weapons.operational.count + ' turrets=' + $Ship.turrets.operational.count + ' missile_turrets=' + $Ship.missileturrets.operational.count"/>
                    </do_else>
                  </do_if>
                  <do_else>
                    <set_value name="$LoadoutFailures" operation="add"/>
                    <debug_text text="'[X4GC TEST SCENARIO] loadout_lookup FAILED id=' + $Def.$loadout + ' macro=' + $Def.$macro + ' ship=' + $Ship"/>
                  </do_else>
                </do_if>

                <!-- Live tests kept failing on "which of these three identical Xenon fighters
                     am I supposed to designate" - an explicit name makes the instruction
                     unambiguous in the target list. -->
                <set_object_name object="$Ship" name="$Def.$label + ' ' + $Index"/>
                <debug_text text="'[X4GC TEST SCENARIO ORIENTATION] object=' + $Ship + ' name=' + $Ship.knownname + ' authored_yaw=' + $Def.$yaw + ' authored_pitch=' + $Def.$pitch + ' authored_roll=' + $Def.$roll + ' actual_yaw=' + $Ship.rotation.yaw + ' actual_pitch=' + $Ship.rotation.pitch + ' actual_roll=' + $Ship.rotation.roll"/>

                <!-- A remotely created ship receives a dynamic zone at the
                     requested sector position.  component.position is local
                     to that zone, so convert it back to sector coordinates
                     before validating the absolute anchor. -->
                <do_if value="$Remote">
                  <create_position name="$ShipSectorPosition" object="$Ship" space="$ScenarioSector"/>
                  <set_value name="$ExpectedSectorX" exact="ScenarioRoot.$PendingAnchorX + $Def.$x"/>
                  <set_value name="$ExpectedSectorY" exact="ScenarioRoot.$PendingAnchorY + $Def.$y"/>
                  <set_value name="$ExpectedSectorZ" exact="ScenarioRoot.$PendingAnchorZ + $Def.$distance"/>
                </do_if>
                <do_if value="$Remote and ($Ship.sector != $ScenarioSector
                              or $ShipSectorPosition.x lt $ExpectedSectorX - 10m
                              or $ShipSectorPosition.x gt $ExpectedSectorX + 10m
                              or $ShipSectorPosition.y lt $ExpectedSectorY - 10m
                              or $ShipSectorPosition.y gt $ExpectedSectorY + 10m
                              or $ShipSectorPosition.z lt $ExpectedSectorZ - 10m
                              or $ShipSectorPosition.z gt $ExpectedSectorZ + 10m)">
                  <set_value name="$LocationFailures" operation="add"/>
                  <debug_text text="'[X4GC TEST SCENARIO] placement mismatch ship=' + $Ship + ' sector_x=' + $ShipSectorPosition.x + ' sector_y=' + $ShipSectorPosition.y + ' sector_z=' + $ShipSectorPosition.z"/>
                </do_if>

                <do_if value="$Def.$role == 'shooter'">
                  <set_value name="$ShooterCount" operation="add"/>
                  <add_to_group groupname="ScenarioRoot.$PlayerShooters" object="$Ship"/>
                  <set_value name="$ShooterWeapons" operation="add" exact="$Ship.weapons.operational.count"/>
                  <set_value name="$ShooterTurrets" operation="add" exact="$Ship.turrets.operational.count"/>
                  <set_value name="$ShooterMissileTurrets" operation="add" exact="$Ship.missileturrets.operational.count"/>
                  <!-- Keep a remote shooter dormant while the owner teleports. -->
                  <cease_fire object="$Ship"/>
                  <do_for_each name="$Weapon" in="$Ship.turrets.operational.list">
                    <set_weapon_mode weapon="$Weapon" weaponmode="weaponmode.holdfire"/>
                    <do_if value="$Weapon.mode == weaponmode.holdfire">
                      <set_value name="$DormantShooterWeapons" operation="add"/>
                    </do_if>
                    <do_else><set_value name="$UnsafeDormantShooterWeapons" operation="add"/></do_else>
                  </do_for_each>
                  <do_for_each name="$Weapon" in="$Ship.missileturrets.operational.list">
                    <set_weapon_mode weapon="$Weapon" weaponmode="weaponmode.holdfire"/>
                    <do_if value="$Weapon.mode == weaponmode.holdfire">
                      <set_value name="$DormantShooterWeapons" operation="add"/>
                    </do_if>
                    <do_else><set_value name="$UnsafeDormantShooterWeapons" operation="add"/></do_else>
                  </do_for_each>
                </do_if>

                <!-- Remove combat drones before hostility is applied. A
                     launched drone is another hostile target and invalidates
                     per-surface projectile attribution even if it crosses the
                     selected component's bearing only briefly. -->
                <do_if value="$Def.$stripdefenceunits and $Ship.units.{unitcategory.defence}.count">
                  <remove_units object="$Ship" category="unitcategory.defence" mk="1"
                                exact="$Ship.units.{unitcategory.defence}.count"/>
                </do_if>
                <set_value name="$DefenceUnits" operation="add"
                           exact="$Ship.units.{unitcategory.defence}.count"/>

                <do_if value="$Def.$repairguard">
                  <set_value name="$RepairObjectCount" operation="add"/>
                  <add_to_group groupname="ScenarioRoot.$RepairObjects" object="$Ship"/>
                </do_if>

                <do_if value="$Def.$holdfire">
                  <set_value name="$SafeObjectCount" operation="add"/>
                  <add_to_group groupname="ScenarioRoot.$SafeObjects" object="$Ship"/>
                  <cease_fire object="$Ship"/>
                  <do_for_each name="$Weapon" in="$Ship.turrets.operational.list">
                    <set_weapon_mode weapon="$Weapon" weaponmode="weaponmode.holdfire"/>
                    <do_if value="$Weapon.mode == weaponmode.holdfire">
                      <set_value name="$SafeWeapons" operation="add"/>
                    </do_if>
                    <do_else><set_value name="$UnsafeWeapons" operation="add"/></do_else>
                  </do_for_each>
                  <do_for_each name="$Weapon" in="$Ship.missileturrets.operational.list">
                    <set_weapon_mode weapon="$Weapon" weaponmode="weaponmode.holdfire"/>
                    <do_if value="$Weapon.mode == weaponmode.holdfire">
                      <set_value name="$SafeWeapons" operation="add"/>
                    </do_if>
                    <do_else><set_value name="$UnsafeWeapons" operation="add"/></do_else>
                  </do_for_each>
                </do_if>

                <!-- Where a ship actually ended up is the first thing anyone
                     asks when it cannot be found: safepos may move it, and a
                     null player.zone would place it somewhere unexpected. -->
                <debug_text text="'[X4GC TEST SCENARIO] created ' + $Ship + ' exists=' + $Ship.exists + ' sector=' + $Ship.sector.knownname + ' dist=' + $Ship.distanceto.{player.ship} + ' playersector=' + player.sector.knownname + ' name=' + $Ship.knownname"/>

                <do_if value="$Def.$hostile">
                  <set_value name="$HostileReference" exact="if ScenarioRoot.$PlayerShooters.count then ScenarioRoot.$PlayerShooters.{1} else player.ship"/>
                  <add_relation_boost object="$Ship" otherobject="$HostileReference"
                                      value="$Ship.owner.relation.kill.max"
                                      decay="1" delay="60min" silent="true"/>
                  <do_if value="$HostileReference.mayattack.{$Ship}">
                    <set_value name="$Hostiles" operation="add"/>
                  </do_if>
                </do_if>

                <do_if value="$Def.$behaviour == 'wait'">
                  <!-- Vanilla order.wait aligns pitch/roll to the ecliptic unless
                       its internal skipalignment parameter is true; shipped
                       md/cpu_ship_manager.xml passes that exact parameter.
                       Derived 3D fixtures opt in; ordinary targets retain it. -->
                  <create_order id="'Wait'" object="$Ship" default="true">
                    <param name="skipalignment" value="$Def.$preserveorientation"/>
                  </create_order>
                </do_if>
                <do_elseif value="$Def.$behaviour == 'attack'">
                  <create_order id="'Attack'" object="$Ship" default="true">
                    <param name="primarytarget" value="player.ship"/>
                    <param name="pursuetargets" value="true"/>
                  </create_order>
                </do_elseif>
              </do_all>

              <debug_text text="'[X4GC TEST SCENARIO] group ' + $Def.$label + ' macro=' + $Def.$macro + ' faction=' + $Def.$faction + ' count=' + $Count + ' distance=' + $Def.$distance + ' behaviour=' + $Def.$behaviour"/>
            </do_for_each>


            <set_value name="ScenarioRoot.$SpawnedSpecId" exact="ScenarioRoot.$PendingSpecId"/>
            <remove_value name="ScenarioRoot.$Pending"/>
            <debug_text text="'[X4GC TEST SCENARIO] spawned spec id=' + ScenarioRoot.$SpawnedSpecId + ' ships=' + ScenarioRoot.$Spawned.count + ' safe_fixtures=' + $SafeObjectCount + ' safe_weapons=' + $SafeWeapons + ' unsafe_weapons=' + $UnsafeWeapons + ' defence_units=' + $DefenceUnits + ' hostiles=' + $Hostiles + ' repair_fixtures=' + $RepairObjectCount + ' shooters=' + $ShooterCount + ' shooter_weapons=' + $ShooterWeapons + ' shooter_turrets=' + $ShooterTurrets + ' shooter_missile_turrets=' + $ShooterMissileTurrets + ' dormant_shooter_weapons=' + $DormantShooterWeapons + ' unsafe_dormant_shooter_weapons=' + $UnsafeDormantShooterWeapons + ' loadout_failures=' + ($LoadoutFailures + $UnsafeDormantShooterWeapons) + ' location_failures=' + $LocationFailures"/>
            <do_if value="ScenarioRoot.$PendingRequestId != ''">
              <raise_lua_event name="'X4GunneryTestLab.ScenarioReady'"
                               param="'x4gct9:' + ScenarioRoot.$PendingRequestId + ':' + ScenarioRoot.$SpawnedSpecId + ':' + ScenarioRoot.$Spawned.count + ':' + $SafeObjectCount + ':' + $SafeWeapons + ':' + $UnsafeWeapons + ':' + $DefenceUnits + ':' + $Hostiles + ':' + $RepairObjectCount + ':' + $ShooterCount + ':' + $ShooterWeapons + ':' + $ShooterTurrets + ':' + $ShooterMissileTurrets + ':' + ($LoadoutFailures + $UnsafeDormantShooterWeapons) + ':' + $LocationFailures"/>
            </do_if>
            <remove_value name="ScenarioRoot.$PendingRequestId"/>
          </actions>
        </cue>

        <!-- A stale or direct scenario_commit must never replace a fixture
             while the player occupies one of its spawned ships.  The normal
             commit cue has the inverse guard, so exactly one consumes the
             event. -->
        <cue name="ScenarioCommitOccupiedReject" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabScenario'" control="'scenario_commit'"/>
            <check_value value="ScenarioRoot.$Accepting? and ScenarioRoot.$Accepting"/>
            <check_value value="ScenarioRoot.$Spawned? and ScenarioRoot.$Spawned.indexof.{player.ship}"/>
          </conditions>
          <actions>
            <set_value name="ScenarioRoot.$Accepting" exact="false"/>
            <remove_value name="ScenarioRoot.$Pending"/>
            <remove_value name="ScenarioRoot.$PendingRequestId"/>
            <debug_text text="'[X4GC TEST SCENARIO] replacement rejected; player occupies spawned ship=' + player.ship"/>
          </actions>
        </cue>


        <!-- Repair only after a real player-ship hit. Unlike minimum-hull or
             invulnerability flags, this leaves the fixture attackable and its
             surface elements eligible for the vanilla shoot controller. -->
        <cue name="ScenarioRepairArm" checkinterval="0.1s">
          <conditions>
            <check_value value="ScenarioRoot.$RepairObjects? and ScenarioRoot.$RepairObjects.count"/>
            <check_value value="ScenarioRoot.$PlayerShooters? and ScenarioRoot.$PlayerShooters.count"/>
          </conditions>
          <actions>
            <debug_text text="'[X4GC TEST SCENARIO] repair guard armed shooters=' + ScenarioRoot.$PlayerShooters.count + ' fixtures=' + ScenarioRoot.$RepairObjects.count"/>
          </actions>
          <cues>
            <cue name="ScenarioRepairHit" instantiate="true">
              <conditions>
                <event_object_attacked_object group="ScenarioRoot.$PlayerShooters"/>
                <check_value value="ScenarioRoot.$RepairObjects? and ScenarioRoot.$RepairObjects.indexof.{event.param}"/>
              </conditions>
              <actions>
                <set_object_shield object="event.param" exact="100"/>
                <set_object_hull object="event.param" exact="100"/>
                <do_if value="@event.param3.{1} and event.param3.{1}.exists">
                  <set_object_shield object="event.param3.{1}" exact="100"/>
                  <set_object_hull object="event.param3.{1}" exact="100"/>
                </do_if>
              </actions>
            </cue>
          </cues>
        </cue>

        <!-- Belt-and-braces safety for hostile live-fire fixtures. Station AI
             may revisit weapon modes after initialisation, so Test Lab owns the
             invariant for as long as the spawned station exists. -->
        <cue name="ScenarioSafetyGuard" instantiate="true" checkinterval="1s">
          <conditions>
            <check_value value="ScenarioRoot.$SafeObjects? and ScenarioRoot.$SafeObjects.count"/>
          </conditions>
          <actions>
            <do_for_each name="$Object" in="ScenarioRoot.$SafeObjects">
              <do_if value="$Object.exists">
                <cease_fire object="$Object"/>
                <do_for_each name="$Weapon" in="$Object.turrets.operational.list">
                  <set_weapon_mode weapon="$Weapon" weaponmode="weaponmode.holdfire"/>
                </do_for_each>
                <do_for_each name="$Weapon" in="$Object.missileturrets.operational.list">
                  <set_weapon_mode weapon="$Weapon" weaponmode="weaponmode.holdfire"/>
                </do_for_each>
              </do_if>
            </do_for_each>
          </actions>
        </cue>

        <!-- DespawnScenario
             AddUITriggeredEvent("X4GunneryTestLabScenario", "despawn_scenario")
             Manual cleanup.  Also clears the spawned id so the SAME spec can be
             spawned again by a plain Reload UI. -->
        <cue name="DespawnScenario" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabScenario'" control="'despawn_scenario'"/>
            <check_value value="not (ScenarioRoot.$Spawned? and ScenarioRoot.$Spawned.indexof.{player.ship})"/>
          </conditions>
          <actions>
            <signal_cue_instantly cue="DespawnScenarioImpl"/>
            <do_if value="ScenarioRoot.$SpawnedSpecId?">
              <remove_value name="ScenarioRoot.$SpawnedSpecId"/>
            </do_if>
          </actions>
        </cue>

        <cue name="DespawnScenarioOccupiedReject" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabScenario'" control="'despawn_scenario'"/>
            <check_value value="ScenarioRoot.$Spawned? and ScenarioRoot.$Spawned.indexof.{player.ship}"/>
          </conditions>
          <actions>
            <debug_text text="'[X4GC TEST SCENARIO] despawn rejected; player occupies spawned ship=' + player.ship"/>
          </actions>
        </cue>

        <!-- DespawnScenarioImpl
             Internal: removes every ship this script created, without explosion.
             Safe when nothing has been spawned.
             Source: cpu_ship_manager.xml:879-894 -->
        <cue name="DespawnScenarioImpl" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <do_if value="ScenarioRoot.$Spawned?">
              <do_for_each name="$Ship" in="ScenarioRoot.$Spawned">
                <do_if value="$Ship.exists">
                  <destroy_object object="$Ship" explosion="false"/>
                </do_if>
              </do_for_each>
              <remove_value name="ScenarioRoot.$Spawned"/>
            </do_if>
            <reset_cue cue="ScenarioRepairArm"/>
            <debug_text text="'[X4GC TEST SCENARIO] despawn complete'"/>
          </actions>
        </cue>

        <!-- ArmCapture / CaptureOnEngage
             Automates the ownership-change leg of the Direct-control fallback
             test.  The Test Lab menu refuses to open during an engagement, so
             the owner cannot be flipped by hand at the moment it matters.
             ArmCapture sets a flag instead; CaptureOnEngage then listens for
             the same direct_watch event the main mod's DirectWatch.Arm cue
             listens for.  That event carries the exact ship and target
             components, and the mod only ever emits it when the directed mode
             is attackenemies, so the trigger is self-verifying: if it fires at
             all, the test preconditions held and no one had to check them.
             faction.player is deliberate.  mayattack is false for the player's
             own property absent a fire-authorisation override, which is the
             condition the mod's OwnerChanged cue tests, and it mirrors the real
             case: you board and capture the ship your turrets were shooting. -->
        <cue name="ArmCapture" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabScenario'" control="'arm_capture'"/>
          </conditions>
          <actions>
            <set_value name="ScenarioRoot.$CaptureArmed" exact="true"/>
            <debug_text text="'[X4GC TEST SCENARIO] capture armed; the next Direct-control engage hands its target to the player 10s in'"/>
          </actions>
        </cue>

        <cue name="CaptureOnEngage" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'direct_watch'"/>
            <check_value value="ScenarioRoot.$CaptureArmed? and ScenarioRoot.$CaptureArmed"/>
          </conditions>
          <!-- Long enough for the turrets to visibly settle on the target, so
               the roll-off is distinguishable from never having engaged. -->
          <delay exact="10s"/>
          <actions>
            <set_value name="ScenarioRoot.$CaptureArmed" exact="false"/>
            <!-- Same transport contract as the main mod: engine prepends $ to
                 Lua string keys and ids may arrive as raw values. -->
            <set_value name="$Target" exact="@event.param3.$target"/>
            <do_if value="typeof $Target != datatype.component and $Target">
              <set_value name="$Target" exact="component.{$Target}"/>
            </do_if>
            <do_if value="$Target and $Target.exists">
              <debug_text text="'[X4GC TEST SCENARIO] capturing ' + $Target.knownname + ' ' + $Target + ' from owner ' + $Target.owner"/>
              <set_owner object="$Target" faction="faction.player"/>
              <debug_text text="'[X4GC TEST SCENARIO] capture done; owner=' + $Target.owner"/>
            </do_if>
            <do_else>
              <debug_text text="'[X4GC TEST SCENARIO] capture skipped; target no longer exists'"/>
            </do_else>
          </actions>
        </cue>

      </cues>
    </cue>
  </cues>
</mdscript>
