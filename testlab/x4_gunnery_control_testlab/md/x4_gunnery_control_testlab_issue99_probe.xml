<?xml version="1.0" encoding="UTF-8"?>
<!--
  Issue #99 live-only evidence probe.

  The production engageability service can accept the exact Paranid M Laser
  through prospective generated muzzle geometry only after its current
  barrelposition fast ray and all six current-origin surface witnesses remain
  blocked.

  This Test Lab-only listener mirrors those current-origin checks and, when UI
  Lua actually streamed generated M-Laser O/P/D geometry, mirrors production's
  prospective construction and rays as diagnostics. It never changes the
  production result.
-->
<mdscript name="X4GunneryTestLabIssue99Probe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../#modding/xsd/md.xsd">
  <cues>
    <cue name="ProbeRoot">
      <actions>
        <set_value name="$Nonce" exact="''"/>
        <set_value name="$Targets" exact="[]"/>
      </actions>
      <cues>
        <cue name="Begin" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_begin'"/>
          </conditions>
          <actions>
            <set_value name="ProbeRoot.$Nonce" exact="@event.param3.$nonce"/>
            <remove_value name="ProbeRoot.$Weapon"/>
            <set_value name="ProbeRoot.$MuzzleKnown" exact="0"/>
            <set_value name="ProbeRoot.$Targets" exact="[]"/>
          </actions>
        </cue>

        <cue name="Member" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_member'"/>
          </conditions>
          <actions>
            <set_value name="$Nonce" exact="@event.param3.$nonce"/>
            <set_value name="$Weapon" exact="@event.param3.$weapon"/>
            <do_if value="typeof $Weapon != datatype.component and $Weapon">
              <set_value name="$Weapon" exact="component.{$Weapon}"/>
            </do_if>
            <do_if value="$Nonce == ProbeRoot.$Nonce
                          and typeof $Weapon == datatype.component
                          and $Weapon.macro == macro.turret_par_m_laser_01_mk1_macro">
              <set_value name="ProbeRoot.$Weapon" exact="$Weapon"/>
              <set_value name="ProbeRoot.$MuzzleKnown" exact="@event.param3.$muzzleknow"/>
              <set_value name="ProbeRoot.$MuzzleOX" exact="@event.param3.$mox"/>
              <set_value name="ProbeRoot.$MuzzleOY" exact="@event.param3.$moy"/>
              <set_value name="ProbeRoot.$MuzzleOZ" exact="@event.param3.$moz"/>
              <set_value name="ProbeRoot.$MuzzlePX" exact="@event.param3.$mpx"/>
              <set_value name="ProbeRoot.$MuzzlePY" exact="@event.param3.$mpy"/>
              <set_value name="ProbeRoot.$MuzzlePZ" exact="@event.param3.$mpz"/>
              <set_value name="ProbeRoot.$MuzzleDX" exact="@event.param3.$mdx"/>
              <set_value name="ProbeRoot.$MuzzleDY" exact="@event.param3.$mdy"/>
              <set_value name="ProbeRoot.$MuzzleDZ" exact="@event.param3.$mdz"/>
            </do_if>
          </actions>
        </cue>

        <cue name="Target" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_target'"/>
          </conditions>
          <actions>
            <set_value name="$Nonce" exact="@event.param3.$nonce"/>
            <set_value name="$Target" exact="@event.param3.$target"/>
            <do_if value="typeof $Target != datatype.component and $Target">
              <set_value name="$Target" exact="component.{$Target}"/>
            </do_if>
            <do_if value="$Nonce == ProbeRoot.$Nonce
                          and typeof $Target == datatype.component
                          and not ProbeRoot.$Targets.indexof.{$Target}">
              <append_to_list name="ProbeRoot.$Targets" exact="$Target"/>
            </do_if>
          </actions>
        </cue>

        <cue name="Commit" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_commit'"/>
          </conditions>
          <actions>
            <set_value name="$Nonce" exact="@event.param3.$nonce"/>
            <do_if value="$Nonce == ProbeRoot.$Nonce
                          and ProbeRoot.$Weapon?
                          and ProbeRoot.$Weapon.exists">
              <set_value name="$Weapon" exact="ProbeRoot.$Weapon"/>
              <do_for_each name="$Target" in="ProbeRoot.$Targets">
                <do_if value="$Target.exists
                              and $Target != $Target.defensible
                              and $Target.macro == macro.turret_arg_l_beam_01_mk1_macro">
                  <check_line_of_sight name="$Fast" object="$Weapon" objectoffset="$Weapon.barrelposition" target="$Target" excludeself="false" useaimtarget="true"/>

                  <set_value name="$MinX" exact="2 * $Target.macro.boundingbox.center.x - $Target.macro.boundingbox.max.x"/>
                  <set_value name="$MinY" exact="2 * $Target.macro.boundingbox.center.y - $Target.macro.boundingbox.max.y"/>
                  <set_value name="$MinZ" exact="2 * $Target.macro.boundingbox.center.z - $Target.macro.boundingbox.max.z"/>
                  <set_value name="$SpanX" exact="$Target.macro.boundingbox.max.x - $MinX"/>
                  <set_value name="$SpanY" exact="$Target.macro.boundingbox.max.y - $MinY"/>
                  <set_value name="$SpanZ" exact="$Target.macro.boundingbox.max.z - $MinZ"/>
                  <set_value name="$XFracs" exact="[0.25, 0.75, 0.50, 0.50, 0.50, 0.50]"/>
                  <set_value name="$YFracs" exact="[0.50, 0.50, 0.25, 0.75, 0.50, 0.50]"/>
                  <set_value name="$ZFracs" exact="[0.50, 0.50, 0.50, 0.50, 0.25, 0.75]"/>
                  <set_value name="$WitnessClear" exact="0"/>
                  <do_for_each name="$Frac" in="$XFracs" counter="$Index">
                    <create_position name="$Sample" object="$Target" space="$Target"
                                     x="$MinX + $XFracs.{$Index} * $SpanX"
                                     y="$MinY + $YFracs.{$Index} * $SpanY"
                                     z="$MinZ + $ZFracs.{$Index} * $SpanZ"/>
                    <check_line_of_sight name="$Witness" object="$Weapon" objectoffset="$Weapon.barrelposition"
                                         target="$Target" targetoffset="$Sample" useaimtarget="false" excludeself="false"/>
                    <do_if value="$Witness">
                      <set_value name="$WitnessClear" operation="add"/>
                    </do_if>
                  </do_for_each>
                  <set_value name="$Barrel" exact="$Weapon.barrelposition"/>

                  <do_if value="ProbeRoot.$MuzzleKnown == 1">
                    <create_orientation name="$ProspectiveBearing" orientation="look_at" refobject="$Target" useaimtarget="true">
                      <position object="$Weapon" space="$Weapon"/>
                    </create_orientation>
                    <create_rotation name="$ProspectivePitchRotation" pitch="$ProspectiveBearing.pitch"/>
                    <create_rotation name="$ProspectiveYawRotation" yaw="$ProspectiveBearing.yaw"/>
                    <transform_position name="$ProspectivePitchedDownstream" refposition="position.[0m,0m,0m]" refrotation="$ProspectivePitchRotation">
                      <position x="ProbeRoot.$MuzzleDX * 1m" y="ProbeRoot.$MuzzleDY * 1m" z="ProbeRoot.$MuzzleDZ * 1m"/>
                    </transform_position>
                    <create_position name="$ProspectiveYawOrigin" x="ProbeRoot.$MuzzleOX * 1m" y="ProbeRoot.$MuzzleOY * 1m" z="ProbeRoot.$MuzzleOZ * 1m"/>
                    <transform_position name="$ProspectiveMuzzle" refposition="$ProspectiveYawOrigin" refrotation="$ProspectiveYawRotation">
                      <position x="$ProspectivePitchedDownstream.x + ProbeRoot.$MuzzlePX * 1m"
                                y="$ProspectivePitchedDownstream.y + ProbeRoot.$MuzzlePY * 1m"
                                z="$ProspectivePitchedDownstream.z + ProbeRoot.$MuzzlePZ * 1m"/>
                    </transform_position>
                    <check_line_of_sight name="$ProspectiveFast" object="$Weapon" objectoffset="$ProspectiveMuzzle" target="$Target" excludeself="false" useaimtarget="true"/>
                    <set_value name="$ProspectiveWitnessClear" exact="0"/>
                    <do_for_each name="$ProspectiveFrac" in="$XFracs" counter="$ProspectiveIndex">
                      <create_position name="$ProspectiveSample" object="$Target" space="$Target"
                                       x="$MinX + $XFracs.{$ProspectiveIndex} * $SpanX"
                                       y="$MinY + $YFracs.{$ProspectiveIndex} * $SpanY"
                                       z="$MinZ + $ZFracs.{$ProspectiveIndex} * $SpanZ"/>
                      <check_line_of_sight name="$ProspectiveWitness" object="$Weapon" objectoffset="$ProspectiveMuzzle"
                                           target="$Target" targetoffset="$ProspectiveSample" useaimtarget="false" excludeself="false"/>
                      <do_if value="$ProspectiveWitness">
                        <set_value name="$ProspectiveWitnessClear" operation="add"/>
                      </do_if>
                    </do_for_each>
                    <debug_text text="'[X4GC TEST ISSUE99 PROBE] nonce=' + $Nonce
                      + ' weapon=' + $Weapon
                      + ' target=' + $Target
                      + ' targetname=' + $Target.knownname
                      + ' fast=' + $Fast
                      + ' witness_clear=' + $WitnessClear + '/6'
                      + ' muzzleknown=' + ProbeRoot.$MuzzleKnown
                      + ' prospective_fast=' + $ProspectiveFast
                      + ' prospective_witness_clear=' + $ProspectiveWitnessClear + '/6'
                      + ' aim_yaw=' + $ProspectiveBearing.yaw
                      + ' aim_pitch=' + $ProspectiveBearing.pitch
                      + ' prospective_x=' + $ProspectiveMuzzle.x
                      + ' prospective_y=' + $ProspectiveMuzzle.y
                      + ' prospective_z=' + $ProspectiveMuzzle.z
                      + ' barrel_x=' + $Barrel.x
                      + ' barrel_y=' + $Barrel.y
                      + ' barrel_z=' + $Barrel.z"/>
                  </do_if>
                  <do_else>
                    <debug_text text="'[X4GC TEST ISSUE99 PROBE] nonce=' + $Nonce
                      + ' weapon=' + $Weapon
                      + ' target=' + $Target
                      + ' targetname=' + $Target.knownname
                      + ' fast=' + $Fast
                      + ' witness_clear=' + $WitnessClear + '/6'
                      + ' muzzleknown=' + ProbeRoot.$MuzzleKnown
                      + ' barrel_x=' + $Barrel.x
                      + ' barrel_y=' + $Barrel.y
                      + ' barrel_z=' + $Barrel.z"/>
                  </do_else>
                </do_if>
              </do_for_each>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>