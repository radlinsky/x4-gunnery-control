<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gunnery Control Test Lab - PR3 Diagnostic Probe Harness
  Developer-only.  Belongs in testlab, NOT in the shipped mod.

  PURPOSE
  PR3 bug: enabling Prefer on B causes fresh rounds to resume A even though
  hard target, soft target, and mod session target remain B. This harness
  exposes six separately invokable probes so the human tester can causally
  bisect which engine-facing operation first changes a working Direct-B
  controller back toward A.

  Each probe executes EXACTLY ONE isolated operation and no other targeting/
  mode operation. The tester establishes Direct-B baseline, marks time, then
  invokes exactly one probe and observes fresh projectile evidence.

  PROBE INVENTORY
  1. NOOP              - logs boundary only; no targeting action.
  2. RELEASE_A         - executes ONLY the exact production previous-target/
                          capital-hierarchy stop_firing_at_target release
                          operations for A/root(A). No set_turret_targets.
  3. NARROW_ANY_B      - ONLY: set_turret_targets object=ship target=[B]
                          preferredtarget=B (no weaponmode).
  4. WIDE_ANY_B        - ONLY: set_turret_targets object=ship target=$hostiles
                          preferredtarget=B (no weaponmode). Builds hostiles
                          using same semantics as production.
  5. NARROW_ATTACKENEMIES_B - ONLY: set_turret_targets object=ship target=[B]
                          preferredtarget=B weaponmode=weaponmode.attackenemies
  6. WIDE_ATTACKENEMIES_B     - ONLY: set_turret_targets object=ship target=$hostiles
                          preferredtarget=B weaponmode=weaponmode.attackenemies

  PROBE INPUTS
  Uses existing PR3 fixture identities resolved from live fixture:
  - player ship
  - A = PR3 TARGET A LEFT OSAKA
  - B = PR3 TARGET B RIGHT OSAKA
  Actual component IDs resolved from live fixture; never hard-coded.

  LOGGING
  Immediately before executing each probe, emits one clear boundary:
    [X4GC TEST PROBE] op=<name> ship=<id> a=<id> b=<id> hostiles=<count if applicable> t=<time>

  TRANSPORT
  Same flat-scalar contract as the scenario script: the engine prepends '$' to
  every Lua string key (research KB, "Lua->MD AddUITriggeredEvent transport
  contract", live-tested 2026-08-04).

    probe_invoke {op=, ship=, a=, b=}
      op     = "noop" | "release_a" | "narrow_any_b" | "wide_any_b"
             | "narrow_attackenemies_b" | "wide_attackenemies_b"
      ship   = player ship component id (from Test Lab fixture)
      a      = PR3 TARGET A LEFT OSAKA component id
      b      = PR3 TARGET B RIGHT OSAKA component id

  RELOAD NOTE: any change to THIS file requires a full game restart, because
  testlab/ md is only reloadable together with the rest of the extension.
  See docs/RELOADING.md.
-->
<mdscript name="X4GunneryTestLabProbe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../#modding/xsd/md.xsd">
  <cues>
    <cue name="ProbeRoot">
      <actions>
        <!-- Probes are off by default. A long play session must not flood
             debug.log because the extension happens to be installed. -->
        <set_value name="$Enabled" exact="false"/>
        <set_value name="$ProbeCount" exact="0"/>
      </actions>
      <cues>

        <!-- ProbeInvoke
             AddUITriggeredEvent("X4GunneryTestLabProbe", "probe_invoke",
               {op=, ship=, a=, b=})
             The single entry point. Dispatches to the appropriate probe cue
             based on the op field. Logs a boundary line before executing. -->
        <cue name="ProbeInvoke" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryTestLabProbe'" control="'probe_invoke'"/>
          </conditions>
          <actions>
            <set_value name="$Op" exact="@event.param3.$op"/>
            <set_value name="$Ship" exact="@event.param3.$ship"/>
            <do_if value="typeof $Ship != datatype.component and $Ship">
              <set_value name="$Ship" exact="component.{$Ship}"/>
            </do_if>
            <set_value name="$A" exact="@event.param3.$a"/>
            <do_if value="typeof $A != datatype.component and $A">
              <set_value name="$A" exact="component.{$A}"/>
            </do_if>
            <set_value name="$B" exact="@event.param3.$b"/>
            <do_if value="typeof $B != datatype.component and $B">
              <set_value name="$B" exact="component.{$B}"/>
            </do_if>

            <!-- Log boundary before any action. -->
            <debug_text text="'[X4GC TEST PROBE] op=' + $Op + ' ship=' + (if $Ship then $Ship else 'none')
              + ' a=' + (if $A then $A else 'none')
              + ' b=' + (if $B then $B else 'none')
              + ' t=' + player.age"/>

            <do_if value="$Op == 'noop'">
              <!-- NOOP: log boundary only; no targeting action. -->
              <debug_text text="'[X4GC TEST PROBE] noop complete t=' + player.age"/>
            </do_if>
            <do_elseif value="$Op == 'release_a'">
              <!-- RELEASE_A: execute ONLY the exact production previous-target/
                   capital-hierarchy stop_firing_at_target release operations for A/root(A).
                   Mirror the exact release behavior from md/x4_gunnery_control.xml Apply cue.
                   No set_turret_targets. -->
              <signal_cue_instantly cue="ProbeReleaseA"/>
            </do_elseif>
            <do_elseif value="$Op == 'narrow_any_b'">
              <!-- NARROW_ANY_B: ONLY set_turret_targets object=ship target=[B] preferredtarget=B -->
              <do_if value="$Ship and $B">
                <set_turret_targets object="$Ship" target="[$B]" preferredtarget="$B"/>
                <debug_text text="'[X4GC TEST PROBE] narrow_any_b applied ship=' + $Ship + ' b=' + $B + ' t=' + player.age"/>
              </do_if>
            </do_elseif>
            <do_elseif value="$Op == 'wide_any_b'">
              <!-- WIDE_ANY_B: ONLY set_turret_targets object=ship target=$hostiles preferredtarget=B -->
              <!-- Build hostiles using same semantics as production: sector scan with kill relation filter. -->
              <do_if value="$Ship and $B">
                <find_ship name="$Hostiles" space="$Ship.sector" masstraffic="false" multiple="true">
                  <match_relation_to faction="faction.player" relation="kill" comparison="le"/>
                </find_ship>
                <do_if value="not $Hostiles.indexof.{$B}">
                  <do_if value="$Ship.mayattack.{$B}">
                    <append_to_list name="$Hostiles" exact="$B"/>
                  </do_if>
                </do_if>
                <set_turret_targets object="$Ship" target="$Hostiles" preferredtarget="$B"/>
                <debug_text text="'[X4GC TEST PROBE] wide_any_b applied ship=' + $Ship + ' b=' + $B + ' hostiles=' + $Hostiles.count + ' t=' + player.age"/>
              </do_if>
            </do_elseif>
            <do_elseif value="$Op == 'narrow_attackenemies_b'">
              <!-- NARROW_ATTACKENEMIES_B: ONLY set_turret_targets object=ship target=[B] preferredtarget=B weaponmode=weaponmode.attackenemies -->
              <do_if value="$Ship and $B">
                <set_turret_targets object="$Ship" target="[$B]" preferredtarget="$B" weaponmode="weaponmode.attackenemies"/>
                <debug_text text="'[X4GC TEST PROBE] narrow_attackenemies_b applied ship=' + $Ship + ' b=' + $B + ' t=' + player.age"/>
              </do_if>
            </do_elseif>
            <do_elseif value="$Op == 'wide_attackenemies_b'">
              <!-- WIDE_ATTACKENEMIES_B: ONLY set_turret_targets object=ship target=$hostiles preferredtarget=B weaponmode=weaponmode.attackenemies -->
              <do_if value="$Ship and $B">
                <find_ship name="$Hostiles" space="$Ship.sector" masstraffic="false" multiple="true">
                  <match_relation_to faction="faction.player" relation="kill" comparison="le"/>
                </find_ship>
                <do_if value="not $Hostiles.indexof.{$B}">
                  <do_if value="$Ship.mayattack.{$B}">
                    <append_to_list name="$Hostiles" exact="$B"/>
                  </do_if>
                </do_if>
                <set_turret_targets object="$Ship" target="$Hostiles" preferredtarget="$B" weaponmode="weaponmode.attackenemies"/>
                <debug_text text="'[X4GC TEST PROBE] wide_attackenemies_b applied ship=' + $Ship + ' b=' + $B + ' hostiles=' + $Hostiles.count + ' t=' + player.age"/>
              </do_if>
            </do_elseif>
            <do_else>
              <debug_text text="'[X4GC TEST PROBE] unknown op=' + $Op + ' t=' + player.age"/>
            </do_else>

            <set_value name="$ProbeCount" exact="$ProbeCount + 1"/>
          </actions>
        </cue>

        <!-- ProbeReleaseA
             Mirrors the exact production release behavior from md/x4_gunnery_control.xml
             Apply cue for the previous-target and capital-hierarchy release.
             This is RELEASE_A: ONLY stop_firing_at_target operations, no set_turret_targets. -->
        <cue name="ProbeReleaseA" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$Ship" exact="ProbeRoot.$ProbeShip"/>
            <set_value name="$A" exact="ProbeRoot.$ProbeA"/>
            <set_value name="$B" exact="ProbeRoot.$ProbeB"/>

            <!-- Exact production release: stop firing at previous target (A). -->
            <do_if value="$A and $A.exists">
              <stop_firing_at_target object="$Ship" target="$A"/>
              <debug_text text="'[X4GC TEST PROBE] release_a: stopped firing at A=' + $A + ' t=' + player.age"/>
            </do_if>

            <!-- Capital-ship hierarchy release (mirroring production). -->
            <do_if value="$A and $A.exists and $A.isclass.[class.ship_l, class.ship_xl]">
              <!-- Release the capital root itself. -->
              <stop_firing_at_target object="$Ship" target="$A"/>
              <!-- Enumerate and release every direct installed turret. -->
              <do_for_each name="$LocTurret" in="$A.turrets.operational.list">
                <do_if value="$LocTurret.exists and $LocTurret != $A">
                  <stop_firing_at_target object="$Ship" target="$LocTurret"/>
                </do_if>
              </do_for_each>
              <!-- Enumerate and release every direct installed missile turret. -->
              <do_for_each name="$LocMissile" in="$A.missileturrets.operational.list">
                <do_if value="$LocMissile.exists and $LocMissile != $A">
                  <stop_firing_at_target object="$Ship" target="$LocMissile"/>
                </do_if>
              </do_for_each>
              <!-- Enumerate and release every direct installed shield. -->
              <do_for_each name="$LocShield" in="$A.shields.operational.list">
                <do_if value="$LocShield.exists and $LocShield != $A">
                  <stop_firing_at_target object="$Ship" target="$LocShield"/>
                </do_if>
              </do_for_each>
              <!-- Enumerate and release every direct installed engine. -->
              <do_for_each name="$LocEngine" in="$A.engines.operational.list">
                <do_if value="$LocEngine.exists and $LocEngine != $A">
                  <stop_firing_at_target object="$Ship" target="$LocEngine"/>
                </do_if>
              </do_for_each>
              <debug_text text="'[X4GC TEST PROBE] release_a: capital hierarchy released ship=' + $Ship + ' a=' + $A + ' t=' + player.age"/>
            </do_if>

            <!-- Station hierarchy release (mirroring production). -->
            <do_if value="$A and $A.exists and $A.isclass.station">
              <!-- Release the station root. -->
              <stop_firing_at_target object="$Ship" target="$A"/>
              <!-- Enumerate and release every operational station module. -->
              <do_for_each name="$LocModule" in="$A.modules.operational.list">
                <do_if value="$LocModule.exists and $LocModule != $A">
                  <stop_firing_at_target object="$Ship" target="$LocModule"/>
                </do_if>
              </do_for_each>
              <!-- Enumerate and release every direct installed turret. -->
              <do_for_each name="$LocTurret2" in="$A.turrets.operational.list">
                <do_if value="$LocTurret2.exists and $LocTurret2 != $A">
                  <stop_firing_at_target object="$Ship" target="$LocTurret2"/>
                </do_if>
              </do_for_each>
              <!-- Enumerate and release every direct installed missile turret. -->
              <do_for_each name="$LocMissile2" in="$A.missileturrets.operational.list">
                <do_if value="$LocMissile2.exists and $LocMissile2 != $A">
                  <stop_firing_at_target object="$Ship" target="$LocMissile2"/>
                </do_if>
              </do_for_each>
              <!-- Enumerate and release every direct installed shield. -->
              <do_for_each name="$LocShield2" in="$A.shields.operational.list">
                <do_if value="$LocShield2.exists and $LocShield2 != $A">
                  <stop_firing_at_target object="$Ship" target="$LocShield2"/>
                </do_if>
              </do_for_each>
              <!-- Enumerate and release every direct installed engine. -->
              <do_for_each name="$LocEngine2" in="$A.engines.operational.list">
                <do_if value="$LocEngine2.exists and $LocEngine2 != $A">
                  <stop_firing_at_target object="$Ship" target="$LocEngine2"/>
                </do_if>
              </do_for_each>
              <debug_text text="'[X4GC TEST PROBE] release_a: station hierarchy released ship=' + $Ship + ' a=' + $A + ' t=' + player.age"/>
            </do_if>

            <debug_text text="'[X4GC TEST PROBE] release_a complete ship=' + $Ship + ' t=' + player.age"/>
          </actions>
        </cue>

      </cues>
    </cue>
  </cues>
</mdscript>
