  <!-- #68 onboard fallback fixture: Behemoth E (Argon L destroyer,
       ship_arg_l_destroyer_02_a_macro - the tracked chair-deficient hull). Turrets
       are spread across TWO groups on purpose: the Behemoth E rejects a singular
       turret-group loadout, so a multi-group loadout is required for readGroups()
       to return usable groups (memory: behemoth-e-no-direct-control-until-68).
       Engine/shield paths and the group+turret macros are taken verbatim from the
       vanilla "behemoth e" loadout (libraries/loadouts.xml, X4 9.00), so every id
       is source-verified rather than inferred. Main-battery weapons are omitted so
       the operational census is turrets-only. -->
  <loadout id="x4gc_testlab_arg_l_destroyer_02_laser_multi" macro="ship_arg_l_destroyer_02_a_macro">
    <macros>
      <engine macro="engine_arg_l_allround_01_mk1_macro" path="../con_engine_03"/>
      <engine macro="engine_arg_l_allround_01_mk1_macro" path="../con_engine_02"/>
      <engine macro="engine_arg_l_allround_01_mk1_macro" path="../con_engine_01"/>
      <shield macro="shield_arg_l_standard_01_mk1_macro" path="../con_shield_l_02"/>
      <shield macro="shield_arg_l_standard_01_mk1_macro" path="../con_shield_l_01"/>
    </macros>
    <groups>
      <turrets macro="turret_arg_m_laser_02_mk1_macro" group="group_front_up_mid" exact="2"/>
      <turrets macro="turret_arg_m_laser_02_mk1_macro" group="group_mid_up_mid" exact="2"/>
    </groups>
    <software>
      <software ware="software_dockmk2"/>
      <software ware="software_flightassistmk1"/>
      <software ware="software_scannerlongrangemk2"/>
      <software ware="software_scannerobjectmk2"/>
      <software ware="software_targetmk1"/>
