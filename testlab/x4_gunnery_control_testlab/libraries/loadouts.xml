  <!-- #68 onboard fallback fixture: Behemoth (Terran L destroyer). Beam turrets
       are spread across TWO groups on purpose - the Behemoth E rejects a singular
       turret-group loadout, so a multi-group loadout is required for readGroups()
       to return usable groups (memory: behemoth-e-no-direct-control-until-68). -->
  <loadout id="x4gc_testlab_ter_l_destroyer_01_beam" macro="ship_ter_l_destroyer_01_a_macro">
    <macros>
      <engine macro="engine_ter_l_allround_01_mk1_macro" path="../con_engine_02"/>
      <engine macro="engine_ter_l_allround_01_mk1_macro" path="../con_engine_01"/>
      <shield macro="shield_ter_l_standard_01_mk1_macro" path="../con_shieldgen_02"/>
      <shield macro="shield_ter_l_standard_01_mk1_macro" path="../con_shieldgen_01"/>
    </macros>
    <groups>
      <turrets macro="turret_ter_l_beam_01_mk1_macro" group="group_back_mid_mid" exact="2"/>
      <turrets macro="turret_ter_l_beam_01_mk1_macro" group="group_front_down_mid" exact="2"/>
