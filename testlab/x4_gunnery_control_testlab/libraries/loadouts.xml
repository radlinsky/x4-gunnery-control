      <engine macro="engine_arg_xl_allround_01_mk1_macro" path="../con_engine_01"/>
      <shield macro="shield_arg_xl_standard_01_mk1_macro" path="../con_shield_xl_03"/>
      <shield macro="shield_arg_xl_standard_01_mk1_macro" path="../con_shield_xl_02"/>
      <shield macro="shield_arg_xl_standard_01_mk1_macro" path="../con_shield_xl_01"/>
    </macros>
    <groups>
      <turrets macro="turret_arg_m_beam_02_mk1_macro" group="group_front_left_up" exact="2"/>
      <turrets macro="turret_arg_m_plasma_02_mk1_macro" group="group_front_right_up" exact="2"/>
    </groups>
    <software>
      <software ware="software_dockmk2"/>
      <software ware="software_flightassistmk1"/>
      <software ware="software_scannerlongrangemk2"/>
