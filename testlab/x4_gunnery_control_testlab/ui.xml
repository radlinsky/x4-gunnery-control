<?xml version="1.0" encoding="UTF-8"?>
<addon name="x4_gunnery_control_testlab" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../ui/core/addon.xsd">
  <environment type="menus">
    <dependency name="x4_gunnery_control"/>
    <dependency name="ego_detailmonitorhelper"/>
    <dependency name="ego_detailmonitor"/>
    <dependency name="kuertee_ui_extensions"/>
    <!-- scenario_spec.lua must load BEFORE testlab.lua: it publishes the global
         the menu reads on load. Being an ordinary ui/*.lua entry is what lets a
         spec edit ship with install + Reload UI instead of a game restart. -->
    <file name="ui/testlab_state.lua"/>
    <file name="ui/scenario_spec.lua"/>
    <file name="ui/testlab.lua"/>
    <!-- PR3 diagnostic probe harness: loads after testlab so it can reference
         the same scenario spec global and return to the Test Lab menu. -->
    <file name="ui/probe.lua"/>
  </environment>
</addon>
