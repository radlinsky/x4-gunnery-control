<?xml version="1.0" encoding="UTF-8"?>
<mdscript name="X4GunneryControl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../#modding/xsd/md.xsd">
  <!-- Savegame-side safety record for a temporary Engage override. The console
       always restores immediately when possible; this cue covers save/load. -->
  <cues>
    <cue name="State">
      <cues>
        <!-- One commit carries the encoded Lua record plus the optional target.
             Keeping them together avoids a save between the old two events
             producing a session associated with a previous target. -->
        <cue name="CommitSession" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'session_commit'"/>
          </conditions>
          <actions>
            <set_value name="State.$active" exact="@event.param3.$payload"/>
            <do_if value="not State.$active">
              <set_value name="State.$active" exact="@event.param3.{'payload'}"/>
            </do_if>
            <!-- Clear first. An explicit no-target commit must never retain an
                 older component reference. Lua table keys may be $-prefixed
                 by the transport, hence the two forms below. -->
            <remove_value name="State.$target"/>
            <set_value name="State.$hasTarget" exact="@event.param3.$hasTarget"/>
            <do_if value="not State.$hasTarget">
              <set_value name="State.$hasTarget" exact="@event.param3.{'hasTarget'}"/>
            </do_if>
            <do_if value="State.$hasTarget">
              <set_value name="State.$target" exact="@event.param3.$target"/>
              <do_if value="not State.$target">
                <set_value name="State.$target" exact="@event.param3.{'target'}"/>
              </do_if>
              <do_if value="typeof State.$target != datatype.component and State.$target">
                <set_value name="State.$target" exact="component.{State.$target}"/>
              </do_if>
            </do_if>
          </actions>
        </cue>
        <cue name="EndSession" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'session_end'"/>
          </conditions>
          <actions>
            <remove_value name="State.$active"/>
            <remove_value name="State.$target"/>
            <remove_value name="State.$hasTarget"/>
            <remove_value name="State.$requestNonce"/>
            <remove_value name="State.$acceptedNonce"/>
            <remove_value name="State.$acceptedGeneration"/>
            <!-- Invalidate a grant that has not yet been accepted. -->
            <do_if value="@State.$generation">
              <set_value name="State.$generation" exact="State.$generation + 1"/>
            </do_if>
            <do_else>
              <set_value name="State.$generation" exact="1"/>
            </do_else>
          </actions>
        </cue>
        <cue name="RequestState" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'state_request'"/>
          </conditions>
          <actions>
            <!-- The grant has one scalar parameter, so echo the Lua request
                 nonce alongside the MD-owned generation as
                 x4gc1:&lt;nonce&gt;:&lt;generation&gt;.  Lua rejects a delayed grant
                 whose nonce belongs to a cleared request even if that lease
                 number was never accepted locally. -->
            <set_value name="State.$requestNonce" exact="@event.param3.$nonce"/>
            <do_if value="not State.$requestNonce">
              <set_value name="State.$requestNonce" exact="@event.param3.{'nonce'}"/>
            </do_if>
            <do_if value="State.$requestNonce">
              <do_if value="@State.$generation">
                <set_value name="State.$generation" exact="State.$generation + 1"/>
              </do_if>
              <do_else>
                <set_value name="State.$generation" exact="1"/>
              </do_else>
              <!-- Shipped MD sources use + to compose string expressions. -->
              <raise_lua_event name="'X4GunneryControl.RestoreGrant'" param="'x4gc1:' + State.$requestNonce + ':' + State.$generation"/>
            </do_if>
          </actions>
        </cue>
        <!-- `raise_lua_event` names are expressions in the XSD. This dynamic
             name use remains live-test inference; it is isolated here so a
             failed transport test has one protocol surface to revisit. -->
        <cue name="AcceptState" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'state_accept'"/>
          </conditions>
          <actions>
            <set_value name="State.$acceptedGeneration" exact="@event.param3.$generation"/>
            <do_if value="not State.$acceptedGeneration">
              <set_value name="State.$acceptedGeneration" exact="@event.param3.{'generation'}"/>
            </do_if>
            <set_value name="State.$acceptedNonce" exact="@event.param3.$nonce"/>
            <do_if value="not State.$acceptedNonce">
              <set_value name="State.$acceptedNonce" exact="@event.param3.{'nonce'}"/>
            </do_if>
            <do_if value="State.$acceptedGeneration == State.$generation and State.$acceptedNonce == State.$requestNonce">
              <do_if value="@State.$target">
                <raise_lua_event name="'X4GunneryControl.RestoreTarget.' + State.$generation" param="State.$target"/>
              </do_if>
              <do_else>
                <raise_lua_event name="'X4GunneryControl.RestoreTarget.' + State.$generation" param="0"/>
              </do_else>
              <do_if value="@State.$active">
                <raise_lua_event name="'X4GunneryControl.RestoreSession.' + State.$generation" param="State.$active"/>
              </do_if>
              <do_else>
                <raise_lua_event name="'X4GunneryControl.RestoreSession.' + State.$generation" param="''"/>
              </do_else>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- Exact selected-turret engageability service. Lua owns checkbox membership
         and streams flat component ids; MD owns the per-turret range and
         line-of-fire checks. Each batch repeats its selected members once and
         accepts at most the declared 20 targets. Responses are packed because
         raise_lua_event can carry only one scalar. -->
    <cue name="EngageabilityService">
      <cues>
        <cue name="EngageabilityBegin" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_begin'"/>
          </conditions>
          <actions>
            <set_value name="EngageabilityService.$nonce" exact="@event.param3.$nonce"/>
            <set_value name="EngageabilityService.$expectedmembers" exact="@event.param3.$members"/>
            <set_value name="EngageabilityService.$expectedtargets" exact="[@event.param3.$targets, 20].min"/>
            <set_value name="EngageabilityService.$weapons" exact="[]"/>
            <set_value name="EngageabilityService.$arcknown" exact="[]"/>
            <set_value name="EngageabilityService.$arcmins" exact="[]"/>
            <set_value name="EngageabilityService.$arcmaxs" exact="[]"/>
            <set_value name="EngageabilityService.$targets" exact="[]"/>
            <set_value name="EngageabilityService.$targetids" exact="[]"/>
          </actions>
        </cue>
        <cue name="EngageabilityMember" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_member'"/>
          </conditions>
          <actions>
            <set_value name="$nonce" exact="@event.param3.$nonce"/>
            <set_value name="$weapon" exact="@event.param3.$weapon"/>
            <set_value name="$arcknow" exact="@event.param3.$arcknow"/>
            <set_value name="$arcmin" exact="@event.param3.$arcmin"/>
            <set_value name="$arcmax" exact="@event.param3.$arcmax"/>
            <do_if value="typeof $weapon != datatype.component and $weapon">
              <set_value name="$weapon" exact="component.{$weapon}"/>
            </do_if>
            <do_if value="$nonce == EngageabilityService.$nonce
                          and EngageabilityService.$weapons.count lt EngageabilityService.$expectedmembers
                          and typeof $weapon == datatype.component
                          and not EngageabilityService.$weapons.indexof.{$weapon}">
              <append_to_list name="EngageabilityService.$weapons" exact="$weapon"/>
              <append_to_list name="EngageabilityService.$arcknown" exact="$arcknow"/>
              <append_to_list name="EngageabilityService.$arcmins" exact="$arcmin"/>
              <append_to_list name="EngageabilityService.$arcmaxs" exact="$arcmax"/>
            </do_if>
          </actions>
        </cue>
        <cue name="EngageabilityTarget" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_target'"/>
          </conditions>
          <actions>
            <set_value name="$nonce" exact="@event.param3.$nonce"/>
            <set_value name="$targetid" exact="@event.param3.$target"/>
            <set_value name="$target" exact="$targetid"/>
            <do_if value="typeof $target != datatype.component and $target">
              <set_value name="$target" exact="component.{$target}"/>
            </do_if>
            <do_if value="$nonce == EngageabilityService.$nonce
                          and EngageabilityService.$targets.count lt EngageabilityService.$expectedtargets
                          and typeof $target == datatype.component
                          and not EngageabilityService.$targets.indexof.{$target}">
              <append_to_list name="EngageabilityService.$targets" exact="$target"/>
              <append_to_list name="EngageabilityService.$targetids" exact="$targetid"/>
            </do_if>
          </actions>
        </cue>
        <cue name="EngageabilityCommit" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'engageability_commit'"/>
          </conditions>
          <actions>
            <set_value name="$nonce" exact="@event.param3.$nonce"/>
            <do_if value="$nonce == EngageabilityService.$nonce">
              <set_value name="$completed" exact="0"/>
              <do_for_each name="$target" in="EngageabilityService.$targets" counter="$targetindex">
                <set_value name="$engageable" exact="0"/>
                <set_value name="$known" exact="0"/>
                <do_for_each name="$weapon" in="EngageabilityService.$weapons" counter="$weaponindex">
                  <!-- rotation_x restrictions in shipped turret components are
                       pitch limits in this fixed mount-local reference frame.
                       Issue #67 r32 live-proved that X4 fires when a selected
                       component's origin is outside the stop but its hittable
                       aim point is inside, so evaluate the weapon-local
                       useaimtarget bearing rather than the component origin.
                       Unknown/modded macros remain UNKNOWN rather than being
                       falsely promoted by range + line of fire alone. -->
                  <do_if value="EngageabilityService.$arcknown.{$weaponindex} == 1">
                    <set_value name="$known" operation="add"/>
                    <create_orientation name="$aimorientation" orientation="look_at"
                                        refobject="$target" useaimtarget="true">
                      <position object="$weapon" space="$weapon"/>
                    </create_orientation>
                    <set_value name="$aimpitch" exact="$aimorientation.pitch"/>
                    <do_if value="$aimpitch ge (EngageabilityService.$arcmins.{$weaponindex} * 1deg)
                                  and $aimpitch le (EngageabilityService.$arcmaxs.{$weaponindex} * 1deg)
                                  and $weapon.bboxdistanceto.{$target} le $weapon.maxfirerange">
                      <!-- Guided missile turrets need only be able to bear and
                           reach: the missile can steer clear after launch, and
                           the engine does not require a direct muzzle-to-target
                           ray. Unguided missile turrets retain a direct line-of-
                           fire gate but exclude the firing ship so its own hull
                           does not mask a viable launch. Missing or modded ammo
                           guidance data takes this conservative unguided path.
                           Conventional turrets keep the own-hull-aware probe. -->
                      <set_value name="$guidedmissileturret" exact="$weapon.class == class.missileturret and $weapon.ammo.macro and $weapon.ammo.macro.isguided"/>
                      <do_if value="$guidedmissileturret">
                        <set_value name="$lineoffireclear" exact="true"/>
                      </do_if>
                      <do_else>
                        <check_line_of_sight name="$lineoffireclear" object="$weapon" objectoffset="$weapon.barrelposition" target="$target" excludeself="$weapon.class == class.missileturret" useaimtarget="true"/>
                      </do_else>
                      <!-- A large ship/station root's aim point is its bounding-
                           box centre (see check_line_of_sight useaimtarget in the
                           9.00 XSD), which sits inside the hull, so the root ray
                           self-blocks even while turrets fire at surface modules.
                           Mirror vanilla move.attack.object.capital (9.00): on a
                           modular target whose root has no line of fire, fall back
                           to per-module line of fire. First visible module counts
                           this weapon as engageable, matching engine behaviour.
                           Only when $target IS the whole defensible root: vanilla
                           only ever feeds this loop a whole-object attack target
                           (it retargets to a visible module), and on a whole object
                           .defensible is the object itself. A player-selected
                           surface element's .defensible resolves to its parent
                           station, so without this guard the fallback would count
                           any weapon that can see ANY station module as engageable
                           against that one element, inflating the count (#62).
                           canhaveattackablemodules (ship datatype, @-guarded so a
                           station root safely reads null) extends the same root
                           fallback to the rare capital ships whose macro embeds a
                           targetable defence module, matching vanilla target
                           selection (lib.target.selection ismodular or
                           canhaveattackablemodules); harmless where a ship's
                           defence modules are not exposed via .modules. -->
                      <do_if value="not $lineoffireclear
                                    and $target == $target.defensible
                                    and ($target.defensible.ismodular or @$target.canhaveattackablemodules)
                                    and $target.defensible.modules.operational.count gt 1">
                        <set_value name="$modules" exact="$target.defensible.modules.operational.list"/>
                        <append_list_elements name="$modules" other="$target.defensible.modules.construction.list"/>
                        <do_for_each name="$module" in="$modules">
                          <do_if value="$weapon.bboxdistanceto.{$module} le $weapon.maxfirerange">
                            <check_line_of_sight name="$lineoffireclear" object="$weapon" objectoffset="$weapon.barrelposition" target="$module" excludeself="$weapon.class == class.missileturret" useaimtarget="true"/>
                            <do_if value="$lineoffireclear">
                              <break/>
                            </do_if>
                          </do_if>
                        </do_for_each>
                        <remove_value name="$modules"/>
                      </do_if>
                      <!-- Bounded surface-element line-of-fire fallback (#69). The
                           root useaimtarget ray above samples a SINGLE hittable
                           aim point of the victim mesh; live proof on the selected
                           Argon L engine shows that point (and the bbox centre)
                           self-block while X4 fires at and hits a different in-arc
                           point of the same component. When the target is a child
                           surface element (its .defensible resolves to the parent
                           ship/station, i.e. $target != $target.defensible, which
                           is the complement of the whole-root module fallback
                           above) on a conventional turret, probe a fixed handful of
                           interior bounding-box points and accept on the first one
                           with a clear muzzle ray. bbox min per axis = 2*center -
                           max (repo idiom). Six face-interior samples only: two per
                           axis at 0.25/0.75 with the others centred; this is a
                           bounded diagnostic-derived witness set, not a
                           reproduction of native fire-control sampling. -->
                      <do_if value="not $lineoffireclear
                                    and $weapon.class != class.missileturret
                                    and $target != $target.defensible">
                        <set_value name="$surfaceminx" exact="2 * $target.macro.boundingbox.center.x - $target.macro.boundingbox.max.x"/>
                        <set_value name="$surfaceminy" exact="2 * $target.macro.boundingbox.center.y - $target.macro.boundingbox.max.y"/>
                        <set_value name="$surfaceminz" exact="2 * $target.macro.boundingbox.center.z - $target.macro.boundingbox.max.z"/>
                        <set_value name="$surfacespanx" exact="$target.macro.boundingbox.max.x - $surfaceminx"/>
                        <set_value name="$surfacespany" exact="$target.macro.boundingbox.max.y - $surfaceminy"/>
                        <set_value name="$surfacespanz" exact="$target.macro.boundingbox.max.z - $surfaceminz"/>
                        <set_value name="$surfacexfracs" exact="[0.25, 0.75, 0.50, 0.50, 0.50, 0.50]"/>
                        <set_value name="$surfaceyfracs" exact="[0.50, 0.50, 0.25, 0.75, 0.50, 0.50]"/>
                        <set_value name="$surfacezfracs" exact="[0.50, 0.50, 0.50, 0.50, 0.25, 0.75]"/>
                        <do_for_each name="$surfacefrac" in="$surfacexfracs" counter="$surfacei">
                          <create_position name="$surfacesample" object="$target" space="$target"
                                           x="$surfaceminx + $surfacexfracs.{$surfacei} * $surfacespanx"
                                           y="$surfaceminy + $surfaceyfracs.{$surfacei} * $surfacespany"
                                           z="$surfaceminz + $surfacezfracs.{$surfacei} * $surfacespanz"/>
                          <check_line_of_sight name="$lineoffireclear" object="$weapon" objectoffset="$weapon.barrelposition" target="$target" targetoffset="$surfacesample" useaimtarget="false" excludeself="false"/>
                          <do_if value="$lineoffireclear">
                            <break/>
                          </do_if>
                        </do_for_each>
                        <!-- The exact Paranid L Beam can still be self-masked at
                             its resting/current barrelposition while its authored
                             deployed muzzle has a clear ray. Only after the
                             current-origin fast query and all six current-origin
                             witnesses remain blocked, use the accepted per-macro
                             prospective construction. This is not generic turret
                             geometry: O + Ry(runtime aim yaw) *
                             (P + Rx(-runtime aim pitch) * D). -->
                        <do_if value="not $lineoffireclear and $weapon.macro == macro.turret_par_l_beam_01_mk1_macro">
                          <create_orientation name="$prospectivebearing" orientation="look_at" refobject="$target" useaimtarget="true">
                            <position object="$weapon" space="$weapon"/>
                          </create_orientation>
                          <create_rotation name="$prospectivepitchrotation" pitch="$prospectivebearing.pitch"/>
                          <transform_position name="$prospectivepitcheddownstream" refposition="position.[0m,0m,0m]" refrotation="$prospectivepitchrotation">
                            <position x="-0.36177411330546533m" y="0.4829345992763463m" z="55.87084740617998m"/>
                          </transform_position>
                          <create_position name="$prospectiveyaworigin" x="1.877547e-6m" y="2.018104m + 6.145042419433594m" z="-1.043081e-5m"/>
                          <create_rotation name="$prospectiveyawrotation" yaw="$prospectivebearing.yaw"/>
                          <transform_position name="$prospectivemuzzle" refposition="$prospectiveyaworigin" refrotation="$prospectiveyawrotation">
                            <position x="$prospectivepitcheddownstream.x - 1.730653e-6m" y="$prospectivepitcheddownstream.y + 2.926126m" z="$prospectivepitcheddownstream.z - 16.11956m"/>
                          </transform_position>
                          <check_line_of_sight name="$lineoffireclear" object="$weapon" objectoffset="$prospectivemuzzle" target="$target" useaimtarget="true" excludeself="false"/>
                          <do_if value="not $lineoffireclear">
                            <do_for_each name="$prospectivefrac" in="$surfacexfracs" counter="$prospectivei">
                              <create_position name="$prospectivesample" object="$target" space="$target"
                                               x="$surfaceminx + $surfacexfracs.{$prospectivei} * $surfacespanx"
                                               y="$surfaceminy + $surfaceyfracs.{$prospectivei} * $surfacespany"
                                               z="$surfaceminz + $surfacezfracs.{$prospectivei} * $surfacespanz"/>
                              <check_line_of_sight name="$lineoffireclear" object="$weapon" objectoffset="$prospectivemuzzle" target="$target" targetoffset="$prospectivesample" useaimtarget="false" excludeself="false"/>
                              <do_if value="$lineoffireclear">
                                <break/>
                              </do_if>
                            </do_for_each>
                          </do_if>
                        </do_if>
                      </do_if>
                      <do_if value="$lineoffireclear">
                        <set_value name="$engageable" operation="add"/>
                      </do_if>
                    </do_if>
                  </do_if>
                </do_for_each>
                <raise_lua_event name="'X4GunneryControl.EngageabilityResult'" param="'x4gce3:' + $nonce + ':' + EngageabilityService.$targetids.{$targetindex} + ':' + $engageable + ':' + $known + ':' + EngageabilityService.$expectedmembers"/>
                <set_value name="$completed" operation="add"/>
              </do_for_each>
              <raise_lua_event name="'X4GunneryControl.EngageabilityBatchComplete'" param="'x4gce2c:' + $nonce + ':' + EngageabilityService.$targets.count + ':' + $completed"/>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- Cinematic aim camera: Follow_A_Lookat_B anchored between a turret and its
         target. Prototype / live-test; see docs/goals/engage-camera-aim.md. -->
    <cue name="CutsceneAim">
      <cues>
        <cue name="Start" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'cutscene_aim_start'"/>
          </conditions>
          <actions>
            <!-- Guarded restart: stop any in-progress cutscene first. -->
            <do_if value="CutsceneAim.$Handle? and CutsceneAim.$Handle != null">
              <stop_cutscene cutscene="CutsceneAim.$Handle"/>
              <set_value name="CutsceneAim.$Handle" exact="null"/>
            </do_if>
            <!-- Transport contract (live-tested 2026-08-04, final): the engine
                 PREPENDS $ to every Lua string key during Lua->MD conversion,
                 so Lua "anchor" arrives here as the variable key $anchor, read
                 via event.param3.$anchor. Never pre-prefix $ on the Lua side
                 (it becomes the unreadable $$anchor). Ids arrive as real
                 component objects via ConvertStringToLuaID; keep @ so a
                 malformed event logs instead of erroring. The brace-lookup
                 fallback covers the only other possible arrival form (a raw
                 string key), since each live test costs a full relaunch. -->
            <set_value name="CutsceneAim.$Anchor" exact="@event.param3.$anchor"/>
            <do_if value="not CutsceneAim.$Anchor">
              <set_value name="CutsceneAim.$Anchor" exact="@event.param3.{'anchor'}"/>
            </do_if>
            <set_value name="CutsceneAim.$Target" exact="@event.param3.$target"/>
            <do_if value="not CutsceneAim.$Target">
              <set_value name="CutsceneAim.$Target" exact="@event.param3.{'target'}"/>
            </do_if>
            <set_value name="CutsceneAim.$Pov" exact="@event.param3.$pov"/>
            <do_if value="not CutsceneAim.$Pov">
              <set_value name="CutsceneAim.$Pov" exact="@event.param3.{'pov'}"/>
            </do_if>
            <!-- Robustness: if the id arrived as a number instead of a component,
                 resolve it. Self-diagnosing because each live test costs a full
                 game relaunch. -->
            <do_if value="typeof CutsceneAim.$Anchor != datatype.component and CutsceneAim.$Anchor">
              <set_value name="CutsceneAim.$Anchor" exact="component.{CutsceneAim.$Anchor}"/>
            </do_if>
            <do_if value="typeof CutsceneAim.$Target != datatype.component and CutsceneAim.$Target">
              <set_value name="CutsceneAim.$Target" exact="component.{CutsceneAim.$Target}"/>
            </do_if>
            <!-- Framing (live-tested 2026-08-04, tuned round 5): anchordist=0
                 puts the camera inside the anchor's hull. Vanilla idiom
                 (cinematiccamera.xml:2504) is a NEGATIVE distance derived from
                 anchor.size. Per-POV: Sit@Target keeps size + 50m (verified
                 right for a small fighter); Sit@Turret wants a close-in camera
                 (~3m class, size-floored). The anchor_x/anchor_y offsets push
                 the anchor off the camera->target sight line so it is not
                 dead-center. Known ceiling: with this between-objects asset,
                 perpendicular turret aim can still put the camera at/inside
                 the hull; a custom cutscene asset with turret-local offsets is
                 a separate research track. -->
            <set_value name="CutsceneAim.$Dist" exact="CutsceneAim.$Anchor.size + 50m"/>
            <do_if value="CutsceneAim.$Pov == 'turret'">
              <set_value name="CutsceneAim.$Dist" exact="[CutsceneAim.$Anchor.size, 3m].max"/>
            </do_if>
            <play_cutscene cinematicmode="true" result="CutsceneAim.$Handle" key="'Follow_A_Lookat_B'">
              <param name="duration" number="999999"/>
              <param name="anchor" object="CutsceneAim.$Anchor"/>
              <param name="target" object="CutsceneAim.$Target"/>
              <param name="anchordist" number="-CutsceneAim.$Dist"/>
              <param name="anchor_x" number="CutsceneAim.$Dist * 0.4"/>
              <param name="anchor_y" number="CutsceneAim.$Dist * 0.2"/>
              <param name="anchor_z" number="0"/>
              <param name="target_x" number="0"/>
              <param name="target_y" number="0"/>
              <param name="target_z" number="0"/>
            </play_cutscene>
            <!-- TargetWatch is cancelled during MD init when no target exists.
                 Re-arm it only after this event has supplied and normalized a
                 target. reset_cue takes effect after this action block, so a
                 retarget replaces the old listener instead of accumulating
                 instances. -->
            <reset_cue cue="TargetWatch"/>
          </actions>
        </cue>

        <cue name="Stop" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'cutscene_aim_stop'"/>
          </conditions>
          <actions>
            <do_if value="CutsceneAim.$Handle? and CutsceneAim.$Handle != null">
              <stop_cutscene cutscene="CutsceneAim.$Handle"/>
              <set_value name="CutsceneAim.$Handle" exact="null"/>
            </do_if>
            <!-- Disarm the per-target listener as well as the camera. -->
            <remove_value name="CutsceneAim.$Target"/>
            <reset_cue cue="TargetWatch"/>
          </actions>
        </cue>

        <!-- Do not register event_object_destroyed until Start has supplied a
             component. A static listener evaluates the object expression at
             MD init, when CutsceneAim.$Target does not exist. -->
        <cue name="TargetWatch" onfail="cancel">
          <conditions>
            <check_value value="CutsceneAim.$Target? and typeof CutsceneAim.$Target == datatype.component"/>
          </conditions>
          <cues>
            <cue name="WatchedTargetDestroyed">
              <conditions>
                <event_object_destroyed object="CutsceneAim.$Target"/>
              </conditions>
              <actions>
                <!-- A reset is applied after the triggering action block. If an
                     old destruction event was already queued while Start
                     retargeted, it must not stop the new target's handle. -->
                <do_if value="CutsceneAim.$Target? and event.object == CutsceneAim.$Target">
                  <do_if value="CutsceneAim.$Handle? and CutsceneAim.$Handle != null">
                    <stop_cutscene cutscene="CutsceneAim.$Handle"/>
                    <set_value name="CutsceneAim.$Handle" exact="null"/>
                  </do_if>
                  <remove_value name="CutsceneAim.$Target"/>
                  <reset_cue cue="parent"/>
                </do_if>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- ponytail: this cue is a real user-facing feature AND is load-bearing.
         X4 engine bug (confirmed by three in-game trials): calling
         SetPlayerCameraTargetView from a turret seat leaves the Esc key dead
         after the player gets up. The only observed cure is a menu that calls
         CreateView/DisplayView (View.createView in ego_viewhelper/viewhelper.lua:38,
         which only runs when View.frames is empty). Our teardown only reaches
         View.hideView, so it never creates again. The show_help action below
         forces CreateView/DisplayView, resetting the engine input context.
         Known ceiling: if the player has hints/help disabled in game options the
         popup may not display and the Esc bug would return. The real upgrade path
         is a direct engine call to reset input context if one is ever found among
         the undeclared engine exports. Do NOT suppress or make this conditional
         without re-testing Esc after a camera session. -->
    <cue name="Notify" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4GunneryControl'" control="'notify'"/>
      </conditions>
      <actions>
        <show_help custom="@event.param3.$text" duration="5s" position="1" silent="true"/>
      </actions>
    </cue>

    <!-- Legacy name: this cue once also hosted the "Prefer My Target" / "Release
         Other Turrets" override (removed in #38 as unreachable with the X4 API).
         It now hosts only Direct-control (DirectFallback + DirectWatch). The name
         is kept deliberately: renaming a save-persistent cue breaks loads. -->
    <cue name="PreferAllTurrets">
      <cues>
        <!-- Gives the directed groups a fallback target list, so a turret that
             cannot bear on $target rolls to a hostile it can engage instead of
             tracking one it will never fire on. That idle turret is the whole
             reason Direct-control hands out a fallback list at all.

             The engine's fallback asks whether a turret can AIM at the preferred
             target, not whether it can hit it. It therefore recovers CANNOT BEAR
             and OUT OF RANGE, both confirmed live, and does NOT recover a blocked
             line of fire: a turret trained on the target with own hull in the way
             holds fire indefinitely, and no mod can observe that condition well
             enough to work around it. Accepted, not a bug in this cue.

             The mode is attackenemies, not autoassist. Autoassist discards
             script-supplied target lists outright; Egosoft say so in a shipped
             comment at aiscripts/fight.attack.object.capital.xml:1756, so a
             fallback list issued for it can never arrive. attackenemies honours
             the list, and vanilla uses exactly this shape at capital.xml:2172.
             Live-tested 2026-08-09 and 2026-08-10 on a player-piloted capital:
             an attackenemies group obeyed preferredtarget, and rolled to another
             hostile when the engaged one was OUT OF RANGE or CANNOT BEAR. It does
             not roll off a target with a blocked line of fire; that condition is
             unrecoverable.

             weaponmode stays a real selector because the console binds the
             checkbox to the mode: a group is in attackenemies exactly when it
             is ticked, so this reaches the directed groups and no one else.

             Two paths share this cue.

             Engage: $target is hostile, so find_ship already returns it and the
             indexof guard appends it only if the sector query somehow missed it.
             Narrow call then wide call, in that order, because stopshootingold
             defaults true and only drops targets absent from the new list, so
             a single wide call could never pull a turret off what it already
             holds. The narrow list of one forces the switch; the wide call then
             restores a fallback set without dislodging the turrets that just
             took the preferred target.

             Ownership change: the target changed hands, so the relation filter
             no longer returns it and mayattack confirms the ship may not shoot
             it. The narrow call is skipped, because it would lock every turret
             onto what is now a friendly. Only the wide call is issued, with no
             preferred target, so stopshootingold drops the stale target and the
             turrets roll to the next hostile instead of falling silent. This
             replaces vanilla's cease_fire at capital.xml:1088-1091, which does
             not reach attackenemies groups the console is directing. -->
        <cue name="DirectFallback" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'X4GunneryControl'" control="'direct_fallback'"/>
          </conditions>
          <actions>
            <set_value name="$ship" exact="@event.param3.$ship"/>
            <set_value name="$target" exact="@event.param3.$target"/>
            <do_if value="typeof $ship != datatype.component and $ship">
              <set_value name="$ship" exact="component.{$ship}"/>
            </do_if>
            <do_if value="typeof $target != datatype.component and $target">
              <set_value name="$target" exact="component.{$target}"/>
            </do_if>
            <do_if value="$ship and $target">
              <find_ship name="$hostiles" space="$ship.sector" masstraffic="false" multiple="true">
                <match_relation_to faction="faction.player" relation="kill" comparison="le"/>
              </find_ship>
              <do_if value="not $hostiles.indexof.{$target}">
                <!-- Only re-insert if the ship can still attack the target.
                     An ownership change makes the target player-owned, so adding
                     it here would direct turrets at a friendly. mayattack checks
                     kill relation and fire-authorisation override together
                     (scriptproperties.xml:119), matching the capital.xml:1070
                     condition that governs the cease_fire we are replacing. -->
                <do_if value="$ship.mayattack.{$target}">
                  <append_to_list name="$hostiles" exact="$target"/>
                </do_if>
              </do_if>
              <do_if value="$hostiles.indexof.{$target}">
                <!-- Target is still hostile: narrow call forces every turret
                     off whatever it holds and onto $target; wide call restores
                     the fallback set for turrets that have no shot at it.
                     Both carry preferredtarget so the engine records the
                     preference even on turrets that cannot engage immediately. -->
                <set_turret_targets object="$ship" target="[$target]" preferredtarget="$target" weaponmode="weaponmode.attackenemies"/>
                <set_turret_targets object="$ship" target="$hostiles" preferredtarget="$target" weaponmode="weaponmode.attackenemies"/>
              </do_if>
              <do_else>
                <!-- Target is no longer attackable (ownership change, surrender,
                     capture). Issue the full hostile set with no preferred target.
                     stopshootingold (default true) drops the now-absent target
                     automatically, so turrets roll to whatever is in the list
                     rather than holding fire. clearpreferred defaults to true. -->
                <set_turret_targets object="$ship" target="$hostiles" weaponmode="weaponmode.attackenemies"/>
              </do_else>
            </do_if>
            <do_else>
              <debug_text text="'[X4GC] direct_fallback: bad payload ship=' + @$ship + ' target=' + @$target" chance="100"/>
            </do_else>
          </actions>
        </cue>

        <!-- Arms an ownership-change listener on the engaged target. Emitted by
             Lua alongside direct_fallback on every target change (emitDirectFallback).
             Emitted on every Direct-control target change, unconditionally.
             Direct-control has one weapon mode now: attackenemies. The old
             pilot-state branch that could send groups to autoassist instead was
             removed on 2026-08-10, so there is no longer a path that skips this.

             Pattern mirrors CutsceneAim: Arm is instantiate and sets module-scope
             variables on DirectWatch; OwnerWatch is a plain sibling, reset by
             Arm each time so only one instance listens at a time. -->
        <cue name="DirectWatch">
          <cues>
            <cue name="Arm" instantiate="true">
              <conditions>
                <event_ui_triggered screen="'X4GunneryControl'" control="'direct_watch'"/>
              </conditions>
              <actions>
                <!-- Same transport contract as all other cues above: engine
                     prepends $ to Lua string keys; ids arrive as components. -->
                <set_value name="DirectWatch.$ship" exact="@event.param3.$ship"/>
                <set_value name="DirectWatch.$target" exact="@event.param3.$target"/>
                <do_if value="typeof DirectWatch.$ship != datatype.component and DirectWatch.$ship">
                  <set_value name="DirectWatch.$ship" exact="component.{DirectWatch.$ship}"/>
                </do_if>
                <do_if value="typeof DirectWatch.$target != datatype.component and DirectWatch.$target">
                  <set_value name="DirectWatch.$target" exact="component.{DirectWatch.$target}"/>
                </do_if>
                <!-- reset_cue cancels the current OwnerWatch (if any) and
                     re-arms it with the new target. Without this, each engage
                     would accumulate a separate listener on a different target. -->
                <reset_cue cue="OwnerWatch"/>
              </actions>
            </cue>

            <!-- Listens for an ownership change on the engaged target and signals
                 Lua to re-issue the directed fallback. onfail=cancel means the
                 cue self-cancels if its check_value is false at arm time (i.e.,
                 DirectWatch.$target is not yet a component). -->
            <cue name="OwnerWatch" onfail="cancel">
              <conditions>
                <check_value value="DirectWatch.$target? and typeof DirectWatch.$target == datatype.component"/>
              </conditions>
              <cues>
                <cue name="OwnerChanged">
                  <conditions>
                    <event_object_changed_owner object="DirectWatch.$target"/>
                  </conditions>
                  <actions>
                    <!-- Re-issue only when the ship can no longer attack the
                         target. An owner change that keeps the target hostile
                         (faction swap within the enemy set) needs no action;
                         the engaged list is already correct. mayattack covers
                         kill relation plus fire-authorisation override, matching
                         capital.xml:1070 exactly. DirectTargetLost carries the
                         target component as its scalar so Lua can verify this
                         event is for the current session's engaged target and
                         not a stale one from a previous engagement. -->
                    <do_if value="DirectWatch.$ship? and not DirectWatch.$ship.mayattack.{DirectWatch.$target}">
                      <raise_lua_event name="'X4GunneryControl.DirectTargetLost'" param="DirectWatch.$target"/>
                    </do_if>
                  </actions>
                </cue>
              </cues>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- #68 onboard Map ingress. Adds a "Gunnery Control" action to the Map
         right-click menu of the ONE ship the player is physically inside, via
         the Interact Menu API bundled with UI Extensions (SirNukes Mod Support
         APIs). If that API is absent, Get_Actions never signals, this whole
         block is inert, and the chair path is untouched. -->
    <cue name="OnboardIngress">
      <cues>
        <cue name="AddAction" instantiate="true">
          <conditions>
            <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions"/>
          </conditions>
          <actions>
            <set_value name="$object" exact="@event.param.$object"/>
            <!-- Only the exact player-owned ship currently containing the player,
                 and only if it has at least one operational turret group. This
                 excludes another owned ship, a subordinate, a docked-but-not-
                 entered ship, and any station (all fail $object == player.container). -->
            <do_if value="$object and $object.isclass.ship and $object.owner == faction.player and $object == player.container">
              <find_object_component name="$turret" object="$object" class="class.turret" checkoperational="true" multiple="false"/>
              <do_if value="$turret">
                <!-- $section: 'interaction' is the intended section for an action on
                     the player's own ship (not an order on an enemy). Confirm the
                     exact token against the installed Interact Menu API in the
                     Task 6 live run; a wrong token only misplaces the entry. -->
                <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
                  $id       = 'x4gc_open_onboard',
                  $section  = 'interaction',
                  $text     = {20991, 104},
                  $icon     = 'menu_weapon',
                  $callback = OnSelected
                ]"/>
              </do_if>
            </do_if>
          </actions>
        </cue>
        <cue name="OnSelected" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <do_if value="event.param.$id == 'x4gc_open_onboard'">
              <set_value name="$object" exact="event.param.$object"/>
              <!-- Re-validate on selection (the right-click menu closes here, but the
                   Map itself typically stays open): never infer a different ship. Lua
                   re-checks occupancy/ownership/turrets on receipt, parks the session,
                   and it only displays once the Map is actually closed (onOpenOnboard).
                   Whether the Map auto-closes on selection is a Task 6 live observation. -->
              <do_if value="$object and $object == player.container and $object.owner == faction.player">
                <raise_lua_event name="'X4GunneryControl.OpenOnboard'" param="$object"/>
              </do_if>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
