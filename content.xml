<?xml version="1.0" encoding="UTF-8"?>
<content id="x4_gunnery_control" name="X4 Gunnery Control" author="X4 Gunnery Control contributors" version="31" date="2026-08-20" save="false" enabled="1" description="Turns gunnery chairs into a real turret console. Pick which turret groups to engage, choose a target, and watch from the turret or target camera. You say what, not how.">
  <dependency version="900"/>
  <!-- optional="true" on purpose: UI Extensions ships from Nexus and from the Workshop under
       two different extension ids, so no single id matches every install that actually has it.
       A hard dependency disables us for whichever half of users installed the other one.
       kuertee's own recommendation. Load order is still honoured when the id does match. -->
  <dependency id="kuerteeUIExtensionsAndHUD" version="900" optional="true" name="kuertee UI Extensions and HUD"/>
  <!-- Interact Menu API (SirNukes Mod Support APIs, a SEPARATE extension - not bundled in
       kuertee UI Extensions) powers the onboard Map right-click "Gunnery Control" action
       (#68). The dependency id is the extension's content id, which is the Steam Workshop id
       ws_2042901274 (the id other consumers declare, e.g. allectus); "sn_mod_support_apis"
       is only its folder/UI-module name and is NOT a content id. optional="true": if absent,
       Get_Actions never signals, the action never appears, and the chair path is unaffected.
       No version pin so it never blocks load. -->
  <dependency id="ws_2042901274" optional="true" name="SirNukes Mod Support APIs"/>
</content>
